{
  "buildCommand": "exit 0",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/reset",
      "destination": "/reset.html"
    },
    {
      "source": "/alliance-images/:file",
      "destination": "/api/proposal?alliance_image=:file"
    },
    {
      "source": "/game-art/:dir/:file",
      "destination": "/api/proposal?game_art=:dir/:file"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dev.la-s78.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/reset.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Clear-Site-Data",
          "value": "\"cache\""
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/reset",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Clear-Site-Data",
          "value": "\"cache\""
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/dashboard.js": {
      "maxDuration": 30
    }
  }
}
